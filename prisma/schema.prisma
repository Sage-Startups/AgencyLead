generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String?
  companyName  String?
  // user | admin | superadmin
  role         String   @default("user")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Subscription state. Kept on the user so a single query answers
  // "what is this account allowed to do right now".
  // free | starter | agency | pro
  plan                 String    @default("free")
  // Indexed rather than @unique deliberately. This project provisions the
  // database with `prisma db push`, and adding a unique constraint makes push
  // demand --accept-data-loss. Putting that flag in the build command would
  // permanently allow any later schema edit to silently drop production
  // columns, which is a far worse risk than the constraint is worth.
  // Uniqueness is upheld in application code: checkout only creates a Stripe
  // customer when the user has none, and no query uses findUnique on these.
  // If you migrate to versioned migrations later, restore @unique here.
  stripeCustomerId     String?
  stripeSubscriptionId String?
  // Mirrors Stripe: active | trialing | past_due | canceled | incomplete
  subscriptionStatus   String?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)

  leads         Lead[]
  aiAudits      AiAudit[]
  importBatches ImportBatch[]
  activityLogs  ActivityLog[]

  @@index([stripeCustomerId])
}

model Lead {
  id                 String   @id @default(uuid())
  userId             String
  businessName       String
  niche              String
  city               String
  state              String
  zipCode            String?
  websiteUrl         String?
  email              String?
  phone              String?
  googleRating       Float?
  reviewCount        Int?
  websiteQuality     String   @default("unknown")
  hasClearCta        Boolean  @default(false)
  hasQuoteForm       Boolean  @default(false)
  seoNotes           String?
  generalNotes       String?
  opportunityScore   Int      @default(0)
  recommendedService String?
  status             String   @default("new")
  // How this lead entered the system: manual | csv | ai_suggested
  source             String   @default("manual")
  // AI-suggested leads start unverified. The model cannot browse the web, so
  // its suggestions are research starting points, not confirmed businesses.
  // Set true once a human has checked the business exists and its details.
  verified           Boolean  @default(true)
  // Why the AI proposed this prospect, and what still needs checking.
  discoveryNotes     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  aiAudits AiAudit[]
}

model AiAudit {
  id                 String   @id @default(uuid())
  userId             String
  leadId             String
  auditSummary       String
  mainIssues         String
  opportunityReason  String
  recommendedService String
  suggestedOffer     String
  coldEmail          String
  dmMessage          String
  callOpener         String
  followUpMessage    String
  createdAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
}

model WaitlistSignup {
  id          String   @id @default(uuid())
  name        String
  email       String
  companyName String?
  buyerType   String?
  mainService String?
  message     String?
  status      String   @default("new")
  createdAt   DateTime @default(now())
}

model ImportBatch {
  id             String   @id @default(uuid())
  userId         String
  fileName       String
  totalRows      Int
  successfulRows Int
  failedRows     Int
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model ActivityLog {
  id          String   @id @default(uuid())
  userId      String?
  actionType  String
  description String
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}
