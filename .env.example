# Database - Neon Postgres via Vercel Marketplace
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# OpenAI (optional — only needed for AI audit generation)
OPENAI_API_KEY=sk-...

# App secret for session signing (generate with: openssl rand -base64 32)
APP_SECRET=your-secret-here

# Public app URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: override the seeded admin account (recommended for production).
# The admin password is re-applied from ADMIN_PASSWORD on every seed/deploy,
# so set this to rotate it. Defaults to admin@agencyleadradar.com / admin123.
ADMIN_EMAIL=admin@agencyleadradar.com
ADMIN_PASSWORD=admin123

# Optional: override the seeded super admin account (whole-site visibility).
# Defaults to superadmin@agencyleadradar.com / superadmin123 — change these.
SUPERADMIN_EMAIL=superadmin@agencyleadradar.com
SUPERADMIN_PASSWORD=superadmin123

# Stripe billing (optional).
# Without these the app runs fine: pricing falls back to waitlist links and
# the billing page explains that checkout is not configured.
#   STRIPE_SECRET_KEY   - from the Stripe dashboard (use sk_test_... first)
#   STRIPE_WEBHOOK_SECRET - from the webhook endpoint you create in Stripe
#   STRIPE_PRICE_*      - the Price ID for each recurring plan
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_AGENCY=
STRIPE_PRICE_PRO=

# Optional future variables
# PAGESPEED_API_KEY=
